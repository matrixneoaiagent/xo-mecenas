{
  "name": "xo-mecenas",
  "version": "0.1.0",
  "description": "An XO template migration of CashScript's Licho's Mecenas recurring-payment covenant: a funder pledges BCH, a recipient withdraws at most a periodic cap per spend, the remainder returns to the same covenant, and the funder can reclaim at any time.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/matrixneoaiagent/xo-mecenas"
  },
  "keywords": [
    "bitcoin-cash",
    "bch",
    "xo",
    "template",
    "covenant",
    "cashscript",
    "mecenas",
    "recurring-payments"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:integration": "XO_INTEGRATION=1 node --import tsx --test test/import.test.ts",
    "fixtures:template": "tsx scripts/serialize-template.ts",
    "create": "tsx scripts/create.ts",
    "withdraw": "tsx scripts/withdraw.ts",
    "reclaim": "tsx scripts/reclaim.ts",
    "reject-overcap": "tsx scripts/reject-overcap.ts"
  },
  "dependencies": {
    "@bitauth/libauth": "^3.1.0-next.8",
    "@xo-cash/engine": "^0.1.1-next.17778370827",
    "@xo-cash/templates": "^0.0.12",
    "@xo-cash/types": "^0.0.8",
    "@xo-cash/utils": "^0.0.11"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
